# Configuración del Servidor MCP - LogiTrack IQ
# Variables de entorno para autenticación contra Spring Boot Backend

# URL base del backend Spring Boot
SPRING_BOOT_BASE_URL=http://localhost:8080

# Credenciales del usuario AGENTE (rol AGENTE en Spring Security)
AGENT_USERNAME=agente_automatizado
AGENT_PASSWORD=agente123

# Configuración de autenticación JWT
AUTH_LOGIN_ENDPOINT=/api/auth/login
JWT_TOKEN_PREFIX=Bearer

# Configuración del servidor MCP
MCP_SERVER_NAME=logitrack-iq-mcp
MCP_SERVER_VERSION=1.0.0

# Timeouts y reintentos para peticiones HTTP
HTTP_TIMEOUT_MS=10000
HTTP_MAX_RETRIES=3
HTTP_RETRY_DELAY_MS=1000

# Endpoints específicos de la API LogiTrack
API_INVENTORY_ENDPOINT=/api/inventarios
API_PRODUCTS_ENDPOINT=/api/productos
API_WAREHOUSES_ENDPOINT=/api/bodegas
API_SUPPLIERS_ENDPOINT=/api/proveedores
API_ORDERS_ENDPOINT=/api/ordenes
API_SUMMARIES_ENDPOINT=/api/resumenes-panel
API_KPIS_ENDPOINT=/api/kpis